{
  "name": "death-spiral-tracker",
  "version": "0.2.0",
  "description": "Real-time monitoring of toxic convertible notes from SEC EDGAR filings",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "crawler:daily": "ts-node -P tsconfig.crawler.json crawler/jobs/daily-edgar-scan.ts",
    "crawler:8k": "ts-node -P tsconfig.crawler.json crawler/jobs/8k-conversion-scan.ts",
    "crawler:both": "npm run crawler:daily && npm run crawler:8k && npm run crawler:edgar",
    "test:edgar": "ts-node -P tsconfig.crawler.json crawler/jobs/test-edgar-filings.ts",
    "seed": "ts-node -P tsconfig.crawler.json crawler/jobs/seed-deals.ts",
    "crawler:edgar": "ts-node -P tsconfig.crawler.json crawler/jobs/edgar-job.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@supabase/supabase-js": "^2.38.5",
    "axios": "^1.6.8",
    "cheerio": "^1.2.0",
    "next": "^14.2.35",
    "puppeteer": "^25.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/xml2js": "^0.4.14",
    "node-fetch": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}